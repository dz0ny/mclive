    "astro-pagefind": "^1.8.6",
    "astro-seo-schema": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "4.13.13",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.552.0",
