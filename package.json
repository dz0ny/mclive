{
  "name": "hakuto-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --open",
    "dev:fresh": "rm -f .astro/data-store.json && astro dev --open",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome lint --write .",
    "check": "astro check",
    "format": "biome format --write .",
    "dev:worker": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply mclive --local",
    "db:migrate:remote": "wrangler d1 migrations apply mclive --remote",
    "deploy": "wrangler d1 migrations apply mclive --remote && wrangler deploy",
    "bridge:replay": "node bridge/replay.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
