    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "mqtt": "5.16.0",
    "typescript": "^5.9.3",
    "wrangler": "4.147.0"
  }
